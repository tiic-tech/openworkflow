{
  "name": "@tiic-tech/openworkflow",
  "version": "0.1.1",
  "description": "Contract-first workflow system for AI-assisted software development.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiic-tech/openworkflow.git"
  },
  "bugs": {
    "url": "https://github.com/tiic-tech/openworkflow/issues"
  },
  "homepage": "https://github.com/tiic-tech/openworkflow#readme",
  "keywords": [
    "openworkflow",
    "codex",
    "workflow",
    "ai-agents",
    "contracts"
  ],
  "type": "module",
  "bin": {
    "openworkflow": "dist/cli/src/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "schemas",
    "references",
    "skills",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "validate": "npm run build && node dist/cli/src/dev/validateRepositoryContractsCli.js --root .",
    "verify:runtime-surface": "npm run build && node dist/cli/src/dev/verifyRuntimeSurface.js",
    "verify:e2e-workflow": "npm run build && node dist/cli/src/dev/verifyWorkflowE2E.js",
    "verify:agent-e2e": "npm run build && node dist/cli/src/dev/verifyAgentE2E.js",
    "verify:clean": "npm run build && node dist/cli/src/dev/verifyCleanCommand.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run validate && npm run verify:runtime-surface && npm run verify:e2e-workflow && npm run verify:clean",
    "validate:cli": "node dist/cli/src/index.js validate --root /tmp/openworkflow-m04-smoke",
    "smoke:init": "node dist/cli/src/index.js init /tmp/openworkflow-m04-smoke --tools codex --force"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
