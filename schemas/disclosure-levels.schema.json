{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openworkflow.local/schemas/disclosure-levels.schema.json",
  "title": "OpenWorkflow Disclosure Levels",
  "type": "object",
  "required": [
    "schema_version",
    "contract_id",
    "contract_type",
    "title",
    "status",
    "levels"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "contract_id": {
      "type": "string"
    },
    "contract_type": {
      "const": "workflow"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "level",
          "name",
          "default_for_agents",
          "purpose",
          "examples"
        ],
        "properties": {
          "level": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "default_for_agents": {
            "type": "boolean"
          },
          "purpose": {
            "type": "string"
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
