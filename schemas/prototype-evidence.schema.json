{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openworkflow.local/schemas/prototype-evidence.schema.json",
  "title": "OpenWorkflow Prototype Evidence Artifact",
  "type": "object",
  "required": [
    "schema_version",
    "contract_id",
    "contract_type",
    "artifact_type",
    "title",
    "status",
    "validation_target",
    "core_question",
    "prototype_artifact",
    "run",
    "observations",
    "evidence",
    "result",
    "handoff"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "contract_id": {
      "type": "string"
    },
    "contract_type": {
      "const": "prototype"
    },
    "artifact_type": {
      "const": "prototype_evidence"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "validation_target": {
      "type": "string"
    },
    "core_question": {
      "type": "string"
    },
    "prototype_artifact": {
      "type": "object",
      "required": [
        "path",
        "type"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "run": {
      "type": "object",
      "additionalProperties": true
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "result": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "unclear",
        "not_reviewed"
      ]
    },
    "handoff": {
      "type": "object",
      "required": [
        "next_command"
      ],
      "properties": {
        "next_command": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
