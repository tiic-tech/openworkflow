{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openworkflow.local/schemas/prototype-evidence.schema.json",
  "title": "OpenWorkflow Prototype Evidence Artifact",
  "type": "object",
  "required": [
    "schema_version",
    "contract_id",
    "contract_type",
    "artifact_type",
    "title",
    "status",
    "validation_target",
    "core_question",
    "prototype_mode",
    "prompt_pack_type",
    "validation_input",
    "source",
    "internal_pipeline",
    "preflight_quality_gate",
    "direction_count_policy",
    "normalized_input",
    "strategic_core",
    "directions",
    "build_recommendation",
    "prompt_text_manifest",
    "post_validate",
    "image_generation",
    "negative_constraints",
    "review_plan",
    "result",
    "handoff"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "contract_id": {
      "type": "string"
    },
    "contract_type": {
      "const": "prototype"
    },
    "artifact_type": {
      "const": "prototype_evidence"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "validation_target": {
      "type": [
        "string",
        "null"
      ]
    },
    "core_question": {
      "type": "string"
    },
    "prototype_mode": {
      "const": "image_prompt_pack"
    },
    "prompt_pack_type": {
      "type": "string",
      "enum": [
        "strategic_proto_prompt_pack",
        "refined_proto_prompt_pack",
        "proto_review_evidence"
      ]
    },
    "validation_input": {
      "type": "object",
      "required": [
        "mode",
        "refs"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "validation_present",
            "agent_auto_generated"
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "properties": {
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_tool": {
          "type": "string"
        },
        "output_language": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "preflight_quality_gate": {
      "type": "object",
      "required": [
        "vision_status",
        "validation_status",
        "can_proceed",
        "blockers",
        "next_command_when_blocked"
      ],
      "additionalProperties": true
    },
    "internal_pipeline": {
      "type": "object",
      "required": [
        "orchestrator_command",
        "user_visible_command",
        "current_stage",
        "stages"
      ],
      "additionalProperties": true
    },
    "direction_count_policy": {
      "type": "object",
      "required": [
        "requested_count",
        "resolved_count",
        "source",
        "ask_user_question_required"
      ],
      "additionalProperties": true
    },
    "normalized_input": {
      "type": "object",
      "required": [
        "product_domain",
        "primary_user",
        "usage_context",
        "current_alternative",
        "core_pain",
        "desired_behavior_change",
        "strongest_success_signal",
        "core_differentiator",
        "emotional_value",
        "functional_value",
        "trust_requirements",
        "privacy_requirements",
        "non_goals",
        "future_opportunities",
        "validation_target"
      ],
      "additionalProperties": true
    },
    "strategic_core": {
      "type": "object",
      "required": [
        "target_user",
        "behavior_change",
        "mechanism",
        "differentiator",
        "boundary_conditions",
        "central_uncertainty"
      ],
      "additionalProperties": true
    },
    "product_experience_model": {
      "type": "object",
      "required": [
        "product_archetype",
        "primary_canvas",
        "information_architecture",
        "domain_object_model",
        "primary_task_loop",
        "interaction_state_model",
        "data_realism_requirements",
        "visual_language",
        "anti_generic_constraints"
      ],
      "properties": {
        "product_archetype": {
          "type": "string"
        },
        "primary_canvas": {
          "type": "string"
        },
        "information_architecture": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "domain_object_model": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "primary_task_loop": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interaction_state_model": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_realism_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visual_language": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "anti_generic_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "category_quality_bar": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "prototype_reality_gate": {
      "type": "object",
      "required": [
        "status",
        "trigger",
        "required_when_prompt_text_ready",
        "dimensions",
        "failures",
        "outcome_notes",
        "repair_route"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "pass",
            "fail"
          ]
        },
        "trigger": {
          "const": "before_image_generation"
        },
        "required_when_prompt_text_ready": {
          "type": "boolean"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "product_category_fit",
              "primary_canvas_fit",
              "domain_object_realism",
              "task_loop_completeness",
              "interaction_state_coverage",
              "data_realism",
              "anti_generic_constraints"
            ]
          }
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outcome_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "repair_route": {
          "const": "/ow:vision2prompt"
        }
      },
      "additionalProperties": true
    },
    "prompt_pack_integrity_gate": {
      "type": "object",
      "required": [
        "status",
        "trigger",
        "required_when_prompt_text_ready",
        "dimensions",
        "failures",
        "outcome_notes",
        "repair_route"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "pass",
            "fail"
          ]
        },
        "trigger": {
          "const": "before_image_generation"
        },
        "required_when_prompt_text_ready": {
          "type": "boolean"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "direction_count_matches",
              "prompt_text_refs_resolve",
              "generated_image_refs_resolve"
            ]
          }
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outcome_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "repair_route": {
          "const": "/ow:vision2prompt"
        }
      },
      "additionalProperties": true
    },
    "directions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "direction_id",
          "name",
          "strategic_hypothesis",
          "validates",
          "main_risk",
          "distinctness_rationale",
          "prototype_prompt",
          "screen_prompts"
        ],
        "additionalProperties": true
      }
    },
    "build_recommendation": {
      "type": "object",
      "required": [
        "first_direction_id",
        "why_first",
        "success_signals",
        "failure_signals",
        "next_test_if_it_works"
      ],
      "additionalProperties": true
    },
    "tune_input": {
      "type": "object",
      "required": [
        "baseline_source_type",
        "baseline_refs",
        "tune_request",
        "regeneration_scope"
      ],
      "additionalProperties": true
    },
    "baseline_resolution": {
      "type": "object",
      "required": [
        "latest_approved_baseline_group_id",
        "latest_approved_baseline_ref",
        "baseline_lineage",
        "resolution_rule",
        "stale_source_guard"
      ],
      "properties": {
        "latest_approved_baseline_group_id": {
          "type": "string"
        },
        "latest_approved_baseline_ref": {
          "type": "string"
        },
        "baseline_lineage": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resolution_rule": {
          "type": "string"
        },
        "stale_source_guard": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "carry_forward": {
      "type": "object",
      "required": [
        "locked_screens",
        "locked_elements",
        "preserved_improvements",
        "explicit_unlocks",
        "cumulative_drift_guard"
      ],
      "properties": {
        "locked_screens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "locked_elements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preserved_improvements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "explicit_unlocks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cumulative_drift_guard": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "baseline_audit": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_screen_id",
          "screen_name",
          "journey_stage",
          "user_goal",
          "system_state",
          "components",
          "must_preserve"
        ],
        "additionalProperties": true
      }
    },
    "product_system": {
      "type": "object",
      "required": [
        "product_thesis",
        "primary_loop",
        "component_vocabulary",
        "copywriting_style",
        "trust_and_boundary_system",
        "stable_constants",
        "adaptable_variables"
      ],
      "additionalProperties": true
    },
    "delta_rules": {
      "type": "object",
      "properties": {
        "must_inherit": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_add": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_remove": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flexible_change": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "screen_delta_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target_screen_id",
          "source_screen_ids",
          "preserve",
          "add",
          "remove",
          "transform",
          "flexible",
          "acceptance_criteria"
        ],
        "additionalProperties": true
      }
    },
    "screen_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target_screen_id",
          "source_screen_ids",
          "screen_name",
          "generation_scope"
        ],
        "additionalProperties": true
      }
    },
    "global_design_prompt": {
      "type": "string"
    },
    "screen_prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "prompt_id",
          "target_screen_id",
          "source_screen_ids",
          "screen_name",
          "image_role",
          "prompt",
          "negative_prompt",
          "acceptance_criteria"
        ],
        "additionalProperties": true
      }
    },
    "generation_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_checklist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prompt_text_manifest": {
      "type": "object",
      "required": [
        "status",
        "directions_ready",
        "direction_count",
        "prompt_text_refs"
      ],
      "additionalProperties": true
    },
    "post_validate": {
      "type": "object",
      "required": [
        "status",
        "trigger",
        "required_when_direction_count_gte",
        "skip_when_resolved_count",
        "threshold_policy",
        "fingerprint_dimensions",
        "comparisons",
        "failures",
        "outcome_notes",
        "repair_route"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "pass",
            "fail",
            "skipped"
          ]
        },
        "trigger": {
          "const": "after_prompt_assets_ready"
        },
        "required_when_direction_count_gte": {
          "type": "number",
          "minimum": 2
        },
        "skip_when_resolved_count": {
          "type": "number",
          "const": 1
        },
        "threshold_policy": {
          "type": "object",
          "required": [
            "method",
            "max_pairwise_similarity",
            "comparison"
          ],
          "additionalProperties": true
        },
        "fingerprint_dimensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "comparisons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "outcome_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "repair_route": {
          "const": "/ow:vision2prompt"
        }
      },
      "additionalProperties": true
    },
    "image_generation": {
      "type": "object",
      "required": [
        "status",
        "batch_strategy",
        "generated_images",
        "collection_notes"
      ],
      "properties": {
        "generated_images": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "image_id",
              "direction_id",
              "prompt_id",
              "screen_name",
              "path",
              "metadata"
            ],
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "negative_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_plan": {
      "type": "object",
      "additionalProperties": true
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "generated_images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "known_limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "unclear",
        "not_reviewed"
      ]
    },
    "handoff": {
      "type": "object",
      "required": [
        "next_command"
      ],
      "properties": {
        "next_command": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
