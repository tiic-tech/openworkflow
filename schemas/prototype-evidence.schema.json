{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openworkflow.local/schemas/prototype-evidence.schema.json",
  "title": "OpenWorkflow Prototype Evidence Artifact",
  "type": "object",
  "required": [
    "schema_version",
    "contract_id",
    "contract_type",
    "artifact_type",
    "title",
    "status",
    "validation_target",
    "core_question",
    "prototype_mode",
    "reference_analysis",
    "visual_direction",
    "visual_concept_policy",
    "concept_evidence",
    "prototype_artifact",
    "run",
    "implementation_evidence",
    "observations",
    "evidence",
    "verification",
    "self_critique",
    "known_limits",
    "result",
    "handoff"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "contract_id": {
      "type": "string"
    },
    "contract_type": {
      "const": "prototype"
    },
    "artifact_type": {
      "const": "prototype_evidence"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "validation_target": {
      "type": "string"
    },
    "core_question": {
      "type": "string"
    },
    "prototype_mode": {
      "type": "string",
      "enum": [
        "visual",
        "interaction",
        "technical_feasibility",
        "3d_material",
        "workflow",
        "data_logic"
      ]
    },
    "reference_analysis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "patterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "anti_patterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "visual_direction": {
      "type": "object",
      "properties": {
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": "string"
        },
        "tokens": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "visual_concept_policy": {
      "type": "object",
      "required": [
        "image_generation",
        "skip_reason"
      ],
      "properties": {
        "image_generation": {
          "type": "string",
          "enum": [
            "generated",
            "skipped_by_user",
            "not_applicable"
          ]
        },
        "skip_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "concept_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "prototype_artifact": {
      "type": "object",
      "required": [
        "path",
        "type"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "run": {
      "type": "object",
      "additionalProperties": true
    },
    "implementation_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "browser_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "logs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "self_critique": {
      "type": "object",
      "required": [
        "philosophy",
        "hierarchy",
        "execution",
        "specificity",
        "restraint",
        "accessibility",
        "responsive_behavior",
        "repairs"
      ],
      "properties": {
        "philosophy": {
          "type": "string"
        },
        "hierarchy": {
          "type": "string"
        },
        "execution": {
          "type": "string"
        },
        "specificity": {
          "type": "string"
        },
        "restraint": {
          "type": "string"
        },
        "accessibility": {
          "type": "string"
        },
        "responsive_behavior": {
          "type": "string"
        },
        "repairs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "known_limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "unclear",
        "not_reviewed"
      ]
    },
    "handoff": {
      "type": "object",
      "required": [
        "next_command"
      ],
      "properties": {
        "next_command": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
