{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openworkflow.local/schemas/prototype-evidence.schema.json",
  "title": "OpenWorkflow Prototype Evidence Artifact",
  "type": "object",
  "required": [
    "schema_version",
    "contract_id",
    "contract_type",
    "artifact_type",
    "title",
    "status",
    "validation_target",
    "core_question",
    "prototype_mode",
    "prompt_pack_type",
    "validation_input",
    "source",
    "negative_constraints",
    "review_plan",
    "result",
    "handoff"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "contract_id": {
      "type": "string"
    },
    "contract_type": {
      "const": "prototype"
    },
    "artifact_type": {
      "const": "prototype_evidence"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "validation_target": {
      "type": [
        "string",
        "null"
      ]
    },
    "core_question": {
      "type": "string"
    },
    "prototype_mode": {
      "const": "image_prompt_pack"
    },
    "prompt_pack_type": {
      "type": "string",
      "enum": [
        "strategic_proto_prompt_pack",
        "refined_proto_prompt_pack",
        "proto_review_evidence"
      ]
    },
    "validation_input": {
      "type": "object",
      "required": [
        "mode",
        "refs"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "vision_only",
            "validation_present",
            "internally_derived"
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "properties": {
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_tool": {
          "type": "string"
        },
        "output_language": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "normalized_input": {
      "type": "object",
      "additionalProperties": true
    },
    "strategic_core": {
      "type": "object",
      "additionalProperties": true
    },
    "directions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "direction_id",
          "hypothesis",
          "screen_prompts"
        ],
        "additionalProperties": true
      }
    },
    "build_recommendation": {
      "type": "object",
      "additionalProperties": true
    },
    "baseline_audit": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "product_system": {
      "type": "object",
      "additionalProperties": true
    },
    "delta_rules": {
      "type": "object",
      "properties": {
        "must_inherit": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_add": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_remove": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flexible_change": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "screen_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "screen_id"
        ],
        "additionalProperties": true
      }
    },
    "global_design_prompt": {
      "type": "string"
    },
    "screen_prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "prompt_id"
        ],
        "additionalProperties": true
      }
    },
    "negative_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_plan": {
      "type": "object",
      "additionalProperties": true
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "generated_images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "known_limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "unclear",
        "not_reviewed"
      ]
    },
    "handoff": {
      "type": "object",
      "required": [
        "next_command"
      ],
      "properties": {
        "next_command": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
