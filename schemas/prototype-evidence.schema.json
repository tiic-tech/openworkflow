{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openworkflow.local/schemas/prototype-evidence.schema.json",
  "title": "OpenWorkflow Prototype Evidence Artifact",
  "type": "object",
  "required": [
    "schema_version",
    "contract_id",
    "contract_type",
    "artifact_type",
    "title",
    "status",
    "validation_target",
    "core_question",
    "prototype_mode",
    "prompt_pack_type",
    "validation_input",
    "source",
    "internal_pipeline",
    "preflight_quality_gate",
    "direction_count_policy",
    "normalized_input",
    "strategic_core",
    "directions",
    "build_recommendation",
    "prompt_text_manifest",
    "image_generation",
    "negative_constraints",
    "review_plan",
    "result",
    "handoff"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "contract_id": {
      "type": "string"
    },
    "contract_type": {
      "const": "prototype"
    },
    "artifact_type": {
      "const": "prototype_evidence"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "validation_target": {
      "type": [
        "string",
        "null"
      ]
    },
    "core_question": {
      "type": "string"
    },
    "prototype_mode": {
      "const": "image_prompt_pack"
    },
    "prompt_pack_type": {
      "type": "string",
      "enum": [
        "strategic_proto_prompt_pack",
        "refined_proto_prompt_pack",
        "proto_review_evidence"
      ]
    },
    "validation_input": {
      "type": "object",
      "required": [
        "mode",
        "refs"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "validation_present",
            "agent_auto_generated"
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "properties": {
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_tool": {
          "type": "string"
        },
        "output_language": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "preflight_quality_gate": {
      "type": "object",
      "required": [
        "vision_status",
        "validation_status",
        "can_proceed",
        "blockers",
        "next_command_when_blocked"
      ],
      "additionalProperties": true
    },
    "internal_pipeline": {
      "type": "object",
      "required": [
        "orchestrator_command",
        "user_visible_command",
        "current_stage",
        "stages"
      ],
      "additionalProperties": true
    },
    "direction_count_policy": {
      "type": "object",
      "required": [
        "requested_count",
        "resolved_count",
        "source",
        "ask_user_question_required"
      ],
      "additionalProperties": true
    },
    "normalized_input": {
      "type": "object",
      "required": [
        "product_domain",
        "primary_user",
        "usage_context",
        "current_alternative",
        "core_pain",
        "desired_behavior_change",
        "strongest_success_signal",
        "core_differentiator",
        "emotional_value",
        "functional_value",
        "trust_requirements",
        "privacy_requirements",
        "non_goals",
        "future_opportunities",
        "validation_target"
      ],
      "additionalProperties": true
    },
    "strategic_core": {
      "type": "object",
      "required": [
        "target_user",
        "behavior_change",
        "mechanism",
        "differentiator",
        "boundary_conditions",
        "central_uncertainty"
      ],
      "additionalProperties": true
    },
    "directions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "direction_id",
          "name",
          "strategic_hypothesis",
          "validates",
          "main_risk",
          "distinctness_rationale",
          "prototype_prompt",
          "screen_prompts"
        ],
        "additionalProperties": true
      }
    },
    "build_recommendation": {
      "type": "object",
      "required": [
        "first_direction_id",
        "why_first",
        "success_signals",
        "failure_signals",
        "next_test_if_it_works"
      ],
      "additionalProperties": true
    },
    "baseline_audit": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "product_system": {
      "type": "object",
      "additionalProperties": true
    },
    "delta_rules": {
      "type": "object",
      "properties": {
        "must_inherit": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_add": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_remove": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flexible_change": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "screen_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "screen_id"
        ],
        "additionalProperties": true
      }
    },
    "global_design_prompt": {
      "type": "string"
    },
    "screen_prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "prompt_id",
          "screen_name",
          "image_role",
          "prompt",
          "acceptance_criteria"
        ],
        "additionalProperties": true
      }
    },
    "prompt_text_manifest": {
      "type": "object",
      "required": [
        "status",
        "directions_ready",
        "direction_count",
        "prompt_text_refs"
      ],
      "additionalProperties": true
    },
    "image_generation": {
      "type": "object",
      "required": [
        "status",
        "batch_strategy",
        "generated_images",
        "collection_notes"
      ],
      "properties": {
        "generated_images": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "image_id",
              "direction_id",
              "prompt_id",
              "screen_name",
              "path",
              "metadata"
            ],
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "negative_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_plan": {
      "type": "object",
      "additionalProperties": true
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "generated_images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "known_limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "unclear",
        "not_reviewed"
      ]
    },
    "handoff": {
      "type": "object",
      "required": [
        "next_command"
      ],
      "properties": {
        "next_command": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
