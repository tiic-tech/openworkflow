{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openworkflow.local/schemas/artifact-contracts.schema.json",
  "title": "OpenWorkflow Artifact Contracts Index",
  "type": "object",
  "required": [
    "schema_version",
    "contract_id",
    "contract_type",
    "title",
    "status",
    "source_of_truth",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "contract_id": {
      "type": "string"
    },
    "contract_type": {
      "const": "workflow"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "source_of_truth": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_type",
          "contract_type",
          "command",
          "source_of_truth_path",
          "required_keys"
        ],
        "properties": {
          "artifact_type": {
            "type": "string"
          },
          "contract_type": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "source_of_truth_path": {
            "type": "string"
          },
          "required_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
