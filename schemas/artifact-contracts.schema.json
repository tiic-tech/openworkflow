{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openworkflow.local/schemas/artifact-contracts.schema.json",
  "title": "OpenWorkflow Artifact Contracts Index",
  "type": "object",
  "required": [
    "schema_version",
    "contract_id",
    "contract_type",
    "title",
    "status",
    "source_of_truth",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "contract_id": {
      "type": "string"
    },
    "contract_type": {
      "const": "workflow"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "source_of_truth": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
          "required": [
            "artifact_type",
            "contract_type",
            "command",
            "source_of_truth_path",
            "template_path",
            "required_keys"
          ],
        "properties": {
          "artifact_type": {
            "type": "string"
          },
          "contract_type": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "source_of_truth_path": {
            "type": "string"
          },
          "template_path": {
            "type": "string"
          },
          "read_policy": {
            "type": "object",
            "required": [
              "load_by_default",
              "agent_read_order",
              "max_yaml_lines",
              "max_note_lines",
              "raw_evidence"
            ],
            "properties": {
              "load_by_default": {
                "type": "boolean"
              },
              "agent_read_order": {
                "type": "integer"
              },
              "max_yaml_lines": {
                "type": "integer"
              },
              "max_note_lines": {
                "type": "integer"
              },
              "raw_evidence": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "active_pointer": {
            "type": "object",
            "required": [
              "index_path",
              "pointer_key",
              "collection_key",
              "id_key",
              "path_key"
            ],
            "properties": {
              "index_path": {
                "type": "string"
              },
              "pointer_key": {
                "type": "string"
              },
              "collection_key": {
                "type": "string"
              },
              "id_key": {
                "type": "string"
              },
              "path_key": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "required_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
