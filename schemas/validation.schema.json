{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openworkflow.local/schemas/validation.schema.json",
  "title": "OpenWorkflow Validation Contract",
  "type": "object",
  "required": [
    "schema_version",
    "contract_id",
    "contract_type",
    "title",
    "status",
    "core_question",
    "central_uncertainty",
    "hypothesis",
    "target_behavior",
    "feature_classification",
    "critical_assumptions",
    "prototype_scope",
    "prototype_experiment",
    "observable_signals",
    "acceptance",
    "decision_rules",
    "decision_options",
    "vision_gaps",
    "agent_readiness_gate"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "contract_id": {
      "type": "string"
    },
    "contract_type": {
      "const": "validation"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "core_question": {
      "type": "string"
    },
    "central_uncertainty": {
      "type": "string"
    },
    "hypothesis": {
      "type": "string"
    },
    "target_behavior": {
      "type": "string"
    },
    "feature_classification": {
      "type": "object",
      "required": [
        "existential",
        "supporting",
        "later",
        "out_of_scope"
      ],
      "properties": {
        "existential": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supporting": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "later": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "critical_assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prototype_scope": {
      "type": "object",
      "required": [
        "include",
        "exclude"
      ],
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "prototype_experiment": {
      "type": "object",
      "required": [
        "scenario",
        "must_show",
        "must_not_show"
      ],
      "properties": {
        "scenario": {
          "type": "string"
        },
        "must_show": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_not_show": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "observable_signals": {
      "type": "object",
      "required": [
        "pass",
        "fail",
        "ambiguous"
      ],
      "properties": {
        "pass": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fail": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ambiguous": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_rules": {
      "type": "object",
      "required": [
        "continue",
        "revise",
        "pivot",
        "stop",
        "needs_more_evidence"
      ],
      "properties": {
        "continue": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "revise": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pivot": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stop": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "needs_more_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "decision_options": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "continue",
          "revise",
          "pivot",
          "stop",
          "needs_more_evidence"
        ]
      }
    },
    "vision_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agent_readiness_gate": {
      "type": "object",
      "required": [
        "status",
        "blockers",
        "warnings",
        "write_authority"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "missing_validation",
            "thin_validation",
            "stale_validation",
            "ready_for_proto",
            "return_to_vision"
          ]
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "write_authority": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
