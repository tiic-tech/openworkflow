{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openworkflow.local/schemas/vision-session.schema.json",
  "title": "OpenWorkflow Vision Session Artifact",
  "type": "object",
  "required": [
    "schema_version",
    "contract_id",
    "contract_type",
    "artifact_type",
    "title",
    "status",
    "current_question",
    "stable_answers",
    "unresolved_questions",
    "vision_delta",
    "handoff"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "contract_id": {
      "type": "string"
    },
    "contract_type": {
      "const": "vision"
    },
    "artifact_type": {
      "const": "vision_session"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "current_question": {
      "type": "string"
    },
    "stable_answers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vision_delta": {
      "type": "object",
      "additionalProperties": true
    },
    "strategic_core": {
      "type": "object",
      "properties": {
        "target_user": {
          "type": "string"
        },
        "context": {
          "type": "string"
        },
        "current_alternative": {
          "type": "string"
        },
        "pain": {
          "type": "string"
        },
        "desired_behavior_change": {
          "type": "string"
        },
        "core_mechanism": {
          "type": "string"
        },
        "core_differentiator": {
          "type": "string"
        },
        "strongest_success_signal": {
          "type": "string"
        },
        "failure_signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "product_system_seed": {
      "type": "object",
      "properties": {
        "product_thesis": {
          "type": "string"
        },
        "primary_loop": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interaction_model": {
          "type": "string"
        },
        "feature_system": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "emotional_value": {
          "type": "string"
        },
        "functional_value": {
          "type": "string"
        },
        "trust_boundary": {
          "type": "string"
        },
        "privacy_boundary": {
          "type": "string"
        },
        "anti_goals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "future_opportunities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "proto_readiness": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "missing",
            "thin",
            "ready",
            "blocked"
          ]
        },
        "missing_for_proto": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prototype_direction_seeds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prompt_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation_target": {
          "type": "string"
        },
        "downstream_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "coverage": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "missing",
              "thin",
              "solid",
              "conflicted"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "follow_up_question": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "handoff": {
      "type": "object",
      "required": [
        "ready",
        "next_command"
      ],
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "next_command": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
