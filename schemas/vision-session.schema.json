{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openworkflow.local/schemas/vision-session.schema.json",
  "title": "OpenWorkflow Vision Session Artifact",
  "type": "object",
  "required": [
    "schema_version",
    "contract_id",
    "contract_type",
    "artifact_type",
    "title",
    "status",
    "current_question",
    "stable_answers",
    "unresolved_questions",
    "vision_delta",
    "handoff"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "contract_id": {
      "type": "string"
    },
    "contract_type": {
      "const": "vision"
    },
    "artifact_type": {
      "const": "vision_session"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "current_question": {
      "type": "string"
    },
    "stable_answers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vision_delta": {
      "type": "object",
      "additionalProperties": true
    },
    "handoff": {
      "type": "object",
      "required": [
        "ready",
        "next_command"
      ],
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "next_command": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
