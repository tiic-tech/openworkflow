{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openworkflow.local/schemas/workflow-index.schema.json",
  "title": "OpenWorkflow Workflow Index",
  "type": "object",
  "required": [
    "schema_version",
    "contract_id",
    "contract_type",
    "title",
    "status",
    "workflow_root",
    "contracts"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "contract_id": {
      "type": "string"
    },
    "contract_type": {
      "const": "workflow"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "workflow_root": {
      "type": "string"
    },
    "active_change": {
      "type": [
        "string",
        "null"
      ]
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "contract_id",
          "contract_type",
          "path",
          "status"
        ],
        "properties": {
          "contract_id": {
            "type": "string"
          },
          "contract_type": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

