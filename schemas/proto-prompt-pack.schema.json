{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openworkflow.local/schemas/proto-prompt-pack.schema.json",
  "title": "OpenWorkflow Proto Prompt Pack",
  "type": "object",
  "required": [
    "schema_version",
    "contract_id",
    "contract_type",
    "title",
    "status",
    "prompt_pack_type",
    "source",
    "validation_input",
    "preflight_quality_gate",
    "direction_count_policy",
    "normalized_input",
    "strategic_core",
    "directions",
    "build_recommendation",
    "prompt_text_manifest",
    "image_generation",
    "negative_constraints",
    "review_plan"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "contract_id": {
      "type": "string"
    },
    "contract_type": {
      "const": "prototype"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "ready_for_generation",
        "reviewed",
        "accepted",
        "superseded",
        "archived"
      ]
    },
    "prompt_pack_type": {
      "type": "string",
      "enum": [
        "strategic_proto_prompt_pack",
        "refined_proto_prompt_pack",
        "proto_review_evidence"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": true
    },
    "validation_input": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "validation_present",
            "agent_auto_generated"
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "preflight_quality_gate": {
      "type": "object",
      "required": [
        "vision_status",
        "validation_status",
        "can_proceed",
        "blockers",
        "next_command_when_blocked"
      ],
      "properties": {
        "vision_status": {
          "type": "string",
          "enum": [
            "missing",
            "thin",
            "ready"
          ]
        },
        "validation_status": {
          "type": "string",
          "enum": [
            "missing",
            "thin",
            "ready"
          ]
        },
        "can_proceed": {
          "type": "boolean"
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_command_when_blocked": {
          "type": [
            "string",
            "null"
          ]
        },
        "required_followup_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "direction_count_policy": {
      "type": "object",
      "required": [
        "requested_count",
        "resolved_count",
        "source",
        "ask_user_question_required"
      ],
      "properties": {
        "requested_count": {
          "type": [
            "number",
            "null"
          ]
        },
        "resolved_count": {
          "type": "number",
          "minimum": 1
        },
        "source": {
          "type": "string",
          "enum": [
            "user_input",
            "agent_default_after_user_delegation"
          ]
        },
        "ask_user_question_required": {
          "type": "boolean"
        },
        "ask_user_question": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "normalized_input": {
      "type": "object",
      "required": [
        "product_domain",
        "primary_user",
        "usage_context",
        "current_alternative",
        "core_pain",
        "desired_behavior_change",
        "strongest_success_signal",
        "core_differentiator",
        "emotional_value",
        "functional_value",
        "trust_requirements",
        "privacy_requirements",
        "non_goals",
        "future_opportunities",
        "validation_target"
      ],
      "additionalProperties": true
    },
    "strategic_core": {
      "type": "object",
      "required": [
        "target_user",
        "behavior_change",
        "mechanism",
        "differentiator",
        "boundary_conditions",
        "central_uncertainty"
      ],
      "additionalProperties": true
    },
    "directions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "direction_id",
          "name",
          "strategic_hypothesis",
          "validates",
          "main_risk",
          "distinctness_rationale",
          "prototype_prompt",
          "screen_prompts",
          "pm_judgment"
        ],
        "properties": {
          "direction_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "strategic_hypothesis": {
            "type": "string"
          },
          "validates": {
            "type": "string"
          },
          "main_risk": {
            "type": "string"
          },
          "distinctness_rationale": {
            "type": "string"
          },
          "prototype_prompt": {
            "type": "string"
          },
          "screen_prompts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "prompt_id",
                "screen_name",
                "image_role",
                "prompt",
                "acceptance_criteria"
              ],
              "properties": {
                "prompt_id": {
                  "type": "string"
                },
                "screen_name": {
                  "type": "string"
                },
                "image_role": {
                  "type": "string"
                },
                "prompt": {
                  "type": "string"
                },
                "acceptance_criteria": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": true
            }
          },
          "pm_judgment": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "build_recommendation": {
      "type": "object",
      "required": [
        "first_direction_id",
        "why_first",
        "success_signals",
        "failure_signals",
        "next_test_if_it_works"
      ],
      "additionalProperties": true
    },
    "baseline_audit": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "product_system": {
      "type": "object",
      "additionalProperties": true
    },
    "delta_rules": {
      "type": "object",
      "properties": {
        "must_inherit": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_add": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_remove": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flexible_change": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "screen_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target_screen_id",
          "screen_name",
          "generation_order"
        ],
        "properties": {
          "target_screen_id": {
            "type": "string"
          },
          "screen_name": {
            "type": "string"
          },
          "source_screen_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "generation_order": {
            "type": "number"
          }
        },
        "additionalProperties": true
      }
    },
    "global_design_prompt": {
      "type": "string"
    },
    "screen_prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "prompt_id",
          "target_screen_id",
          "screen_name",
          "prompt",
          "acceptance_criteria"
        ],
        "properties": {
          "prompt_id": {
            "type": "string"
          },
          "target_screen_id": {
            "type": "string"
          },
          "screen_name": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "negative_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prompt_text_manifest": {
      "type": "object",
      "required": [
        "status",
        "directions_ready",
        "direction_count",
        "prompt_text_refs"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "ready_for_image_generation",
            "generated"
          ]
        },
        "directions_ready": {
          "type": "boolean"
        },
        "direction_count": {
          "type": "number",
          "minimum": 0
        },
        "prompt_text_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "image_generation": {
      "type": "object",
      "required": [
        "status",
        "batch_strategy",
        "generated_images",
        "collection_notes"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_started",
            "queued",
            "in_progress",
            "complete",
            "blocked"
          ]
        },
        "batch_strategy": {
          "type": "string"
        },
        "generated_images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "collection_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "review_plan": {
      "type": "object",
      "additionalProperties": true
    },
    "review_evidence": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
