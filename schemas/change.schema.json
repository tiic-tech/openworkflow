{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openworkflow.local/schemas/change.schema.json",
  "title": "OpenWorkflow Change Contract",
  "type": "object",
  "required": [
    "schema_version",
    "contract_id",
    "contract_type",
    "title",
    "status",
    "problem",
    "goals",
    "non_goals",
    "affected_paths",
    "acceptance",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "contract_id": {
      "type": "string"
    },
    "contract_type": {
      "const": "change"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "problem": {
      "type": "string"
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affected_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}

